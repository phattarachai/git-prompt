{
    "name": "phattarachai/git-prompt",
    "description": "A PHPStorm-style git branch popup for the terminal — search branches and actions, checkout, update, merge, rebase, commit, push and stash through Laravel Prompts. One global command for every repo.",
    "keywords": ["git", "cli", "terminal", "laravel-prompts", "branch", "tui"],
    "license": "MIT",
    "authors": [
        {
            "name": "Phattarachai",
            "email": "pc@phattarachai.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/prompts": "^0.3.13",
        "symfony/console": "^7.0|^8.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\GitPrompt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\GitPrompt\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/g"],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    }
}
